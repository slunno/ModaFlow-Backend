# Copie este arquivo para .env.local e preencha somente na sua maquina.
# O arquivo .env.local esta no .gitignore e nunca deve ser commitado.
MODAFLOW_LINX_ENABLED=true
MODAFLOW_LINX_DATASOURCE_URL=jdbc:sqlserver://192.168.1.3:1433;databaseName=HOMOLOGACAO_ATUAL;encrypt=true;trustServerCertificate=true
MODAFLOW_LINX_EXPECTED_DATABASE=HOMOLOGACAO_ATUAL
MODAFLOW_LINX_DATASOURCE_USERNAME=<usuario_sql>
MODAFLOW_LINX_DATASOURCE_PASSWORD=<senha_sql>

# Gere uma chave com pelo menos 32 bytes e mantenha-a somente neste arquivo.
MODAFLOW_JWT_SECRET=<segredo_jwt_base64>
